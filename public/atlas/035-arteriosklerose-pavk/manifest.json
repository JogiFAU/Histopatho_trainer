  "slide": {
    "number": "035",
    "name": "Arteriosklerose (pavk)",
    "organ": "Gefäßsystem",
    "diagnosis": "Arteriosklerose (periphere arterielle Verschlusskrankheit - pAVK)",
    "description": [
      "Schichtung der arteriellen Wand: Intima, Membrana elastica interna, Media, Adventitia);",
      "Einlagerung von Lipiden in Intima;",
      "Ausfällung von Cholesterinkristallen (Atherom);",
      "Entzündungsreaktion, u.a. Schaumzellen (Fett abbauende Makrophagen);",
      "Endothelschädigung;",
      "Bild entspricht dem einer chronischen Entzündung;",
      "Bildung von fibrösen Plaques (Intimafibrose);",
      "zusätzlich benachbarte Venen mit Phlebosklerose;"
    ],
