{
  "schema_version": 3,
  "slide": {
    "number": "042",
    "name": "Adeno-Ca des Ösophagus (Barrett-Ca)",
    "organ": "Ösophagus/ösophagogastraler Übergang",
    "diagnosis": "Adenokarzinom des Ösophagus/ösophagogastralen Übergangs (Barrett Karzinom)",
    "description": [
      "typische Schichtung der Muskulatur (äußere Längs- und innere Ringmuskulatur);",
      "Plattenepithel;",
      "Barrett Metaplasie (Plattenepithel wird durch intestinales Zylinderepithel ersetzt);",
      "Tumorgrenze;",
      "kleindrüsiges, diffus infiltrierendes Wachstumsmuster;",
      "lymphozytäres Infiltrat (chronische Komponente mit follikulärer Anordnung);",
      "Zell- und Kernanomalien (deutliche Nucleoli, helle blasige Kerne, Mitosen);",
      "Schleimsezernierung;",
      "Nekrosen;",
      "pT2 (Infiltration der Muskulatur);"
    ],
    "slide_id": "d9b6d907-9c77-4e8e-8e74-fcaded71da7b",
