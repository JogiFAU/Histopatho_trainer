{
  "schema_version": 3,
  "slide": {
    "number": "066",
    "name": "Leichte Dysplasie der Cervix (CIN I)",
    "organ": "Cervix",
    "diagnosis": "leichte plattenepiteliale Dysplasie/ cervikale intraepitheliale Neoplasie/Carcinoma in situ (CIN I) der Cervix uteri",
    "description": [
      "Cervixschleimhaut mit hochprismatischem einschichtigem Epithel;",
      "Cervikaldrüsen;",
      "verschlossene Cervikaldrüse mit eingedicktem Sekret (Ovula naboti);",
      "Schaumzellen;",
      "Kauterrand durch operative Entfernung des Gewebes;",
      "Koilozyten in denen sich HPV vermehrt (große Epithelzellen mit weißem Hof und dysplastischem Kern, kaum Zytoplasma);",
      "Hyperplasie des betroffenen Epithels;",
      "Cervicale intraepitheliale geringgradige Dysplasie im basalen 1/3",
      "aber vollständiger Ausreifung bis zum obersten 1/3;",
      "keine Mitosen;",
      "CIN III siehe #67"
    ],
    "slide_id": "52a434a3-e44a-4148-a3c5-703f113c9636",
