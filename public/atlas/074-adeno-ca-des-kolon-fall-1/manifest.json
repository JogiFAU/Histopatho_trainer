  "slide": {
    "number": "074",
    "name": "Adeno-Ca des Kolon - Fall 1",
    "organ": "Kolon",
    "diagnosis": "Adenokarzinom",
    "description": [
      "typische Schichtung der GI-Muskulatur (äußere Längs- und innere Ringmuskulatur);",
      "normale Colonschleimhaut mit Krypten & Becherzellen;",
      "invasiver Tumor mit infiltrierendem Tiefenwachstum;",
      "schwere Dysplasie (Mitosen, Hyperchromasie, deutliche Nucleoli, verschobene Kern-Plasmarelation, aufgegebene Zellpolarität);",
      "lymphozytäres Entzündungsinfiltrat;",
      "pT2a (Infiltration der inneren Schicht der Lamina muscularis propria);"
    ],
    "slide_id": "09a4e7ec-26ad-4142-af08-7ad1378d30d5",
