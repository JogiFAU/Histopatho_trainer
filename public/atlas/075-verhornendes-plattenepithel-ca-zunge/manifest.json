  "schema_version": 3,
  "slide": {
    "number": "075",
    "name": "Verhornendes Plattenepithel-Ca (Zunge)",
    "organ": "Zunge",
    "diagnosis": "verhornendes Plattenepithelkarzinom",
    "description": [
      "Verlauf der Zungenmuskulatur;",
      "unauffälliges Plattenepithel;",
      "Tumor wächst invasiv in Form von tiefen Plattenepithelzapfen",
      "und multipler Inselbildung in der Tiefe des Gewebes (diskontinuierliches Wachstum);",
      "schwere Dysplasie (viele Mitosen, hyperchromatische Kerne, Nucleoli; verschobene Kern- Plasmarelation);",
      "Hornperlen, sogenannte Königskugeln;",
      "buntes tumorbegleitendes entzündliches Infiltrat",
      "mit vielen Riesenzellen (fressen Hornperlen);",
      "Ulzerationen;"
    ],
