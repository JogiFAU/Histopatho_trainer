{
  "schema_version": 3,
  "slide": {
    "number": "077",
    "name": "Basalzell-Ca (ehemals Basaliom)",
    "organ": "Haut",
    "diagnosis": "Basalzellkarzinom",
    "description": [
      "verhornendes Plattenepithel;",
      "Neoplasie der basophilen Basalzellen des Plattenepithels",
      "(häufig im Bereich der Haarwurzeln);",
      "nodulär-cystisches Wachstum mit Pallisadenstellung der",
      "Tumorzellen im Randbereich;",
      "Dysplasien (Mitosen, Hyperchromasie, verschobene Kern- Plasmarelation);",
      "Tumor umgeben von lockerem Stroma mit Myofibroblasten;",
      "metastasiert so gut wie nie;",
      "aber:häufiges Auftreten eines Lokalrezidivs;",
      "gelegentlich sehr großes Ausmaß",
      "mit ausgeprägten langstreckigen Ulzerationen (sog. Ulcus rodens);"
    ],
    "slide_id": "fdb86ea1-47a1-44d0-8d4c-7a6aeb81fe74",
